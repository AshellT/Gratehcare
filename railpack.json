{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["npm ci --include=dev --prefix backend"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "npm exec --prefix backend -- prisma generate",
        "npm run build --prefix backend"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm run start:prod --prefix backend",
    "paths": ["backend/node_modules/.bin"]
  }
}
