NODE_ENV=development
PORT=4000

# Supabase Postgres — Project Settings → Database
#
# DATABASE_URL (app runtime): Transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# DIRECT_URL (Prisma migrations): Session pooler, port 5432 — same pooler host, NOT port 6543
# If P1001 persists, try: db.YOUR_PROJECT_REF.supabase.co:5432 instead
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

JWT_SECRET=change-me-local-fallback-secret-key
JWT_EXPIRES_IN=1d
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

TEST_ACCOUNT_PASSWORD=0778007350

# Frontend URL (Stripe Checkout success/cancel redirects)
FRONTEND_URL=http://localhost:3000

# Stripe — platform owner's account (all subscription revenue goes here)
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook → POST {API_URL}/api/v1/subscription-billing/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Product → Prices (recurring monthly) from Stripe Dashboard
STRIPE_PRICE_START=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...

# Billing emails (Resend) — optional; logs a warning if unset
RESEND_API_KEY=re_...
BILLING_FROM_EMAIL=GRATEHCARE Billing <billing@yourdomain.com>
