NODE_ENV=development
PORT=4000

# Local Postgres (Docker or installed on the machine)
# For docker compose these are overridden automatically.
DATABASE_URL="postgresql://gratehcare:gratehcare@localhost:5432/gratehcare"
DIRECT_URL="postgresql://gratehcare:gratehcare@localhost:5432/gratehcare"

JWT_SECRET=change-me-local-fallback-secret-key
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads

TEST_ACCOUNT_PASSWORD=0778007350

# Optional Redis
# REDIS_URL=redis://localhost:6379

# Email — Resend or Hostinger SMTP. If neither is set, password-reset links are logged.
# RESEND_API_KEY=re_...
# MAIL_FROM=GRATEHCARE <noreply@your-domain.com>
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=noreply@your-domain.com
# SMTP_PASS=

# Stripe — invoice card payments start as soon as STRIPE_SECRET_KEY is set.
# STRIPE_PRICE_* is only required for SaaS plan checkout.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_START=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ELITE=price_...
