NODE_ENV=development
PORT=4000
# Session pooler (use when direct db.* host is unreachable)
# URL-encode special characters in the password (e.g. ! → %21). Quote the value if it contains !.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=no-verify"
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
JWT_SECRET=change-me-local-fallback
JWT_EXPIRES_IN=1d
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
TEST_ACCOUNT_PASSWORD=0778007350
