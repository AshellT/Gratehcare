{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["npm ci --include=dev"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["npx prisma generate", "npm run build"]
    }
  },
  "deploy": {
    "startCommand": "npm run start:prod",
    "paths": ["node_modules/.bin"]
  }
}
