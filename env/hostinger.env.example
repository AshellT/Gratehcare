# Copy to repo-root `.env` before `docker compose up`.
# Never commit the real `.env`.

POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-generate-a-64-char-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

NODE_ENV=production
PORT=4000

# Public site URL — no trailing slash
FRONTEND_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

TEST_ACCOUNT_PASSWORD=0778007350
UPLOAD_DIR=/data/uploads

# Optional email (Hostinger mailbox SMTP or Resend)
# RESEND_API_KEY=re_...
# MAIL_FROM=GRATEHCARE <noreply@your-domain.com>
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@your-domain.com
SMTP_PASS=your-mailbox-password
MAIL_FROM=GRATEHCARE <noreply@your-domain.com>

# Stripe — invoice card payments need STRIPE_SECRET_KEY (sk_test_ or rk_test_).
# Plan checkout also needs STRIPE_PRICE_START / PRO / ELITE.
# Put real keys only in /opt/gratehcare/.env on the VPS — never commit them.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_START=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ELITE=price_...
